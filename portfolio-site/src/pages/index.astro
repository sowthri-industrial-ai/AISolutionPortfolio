---
// Home page — one-pager listing all three tracks. Page sequence:
//   1. <Header>          (from BaseLayout)
//   2. Page heading + intro paragraph
//   3. <NowHero>         (current snapshot, loaded from now/current.md)
//   4. <TrackSection track="agentic-ai">
//   5. <TrackSection track="assets-ai">
//   6. <TrackSection track="physical-ai">  (renders "Coming soon" — no entries)
//   7. <Footer>          (from BaseLayout)
//
// All track titles + descriptions live inside <TrackSection> for
// centralised editing. Project entries are filtered + sorted by the
// component using the content collection.

import BaseLayout from '../layouts/BaseLayout.astro';
import NowHero from '../components/NowHero.astro';
import TrackSection from '../components/TrackSection.astro';
---

<BaseLayout
  title="AI Solution Portfolio · Sowthri Somasundaram"
  description="Production-grade AI engineering portfolio — agentic AI, industrial assets AI, and physical AI projects on Azure."
>
  <h1 class="mb-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
    AI Solution Portfolio
  </h1>
  <p class="mb-10 max-w-3xl text-base leading-relaxed text-slate-700 sm:text-lg">
    I'm Sowthri Somasundaram, an Industrial AI Solution Architect based in Chennai. This portfolio
    collects production-quality systems I've built on Azure, organized into three tracks: Agentic
    AI, Industrial Assets AI, and Physical AI.
  </p>

  <NowHero />

  <TrackSection track="agentic-ai" />
  <TrackSection track="assets-ai" />
  <TrackSection track="physical-ai" />
</BaseLayout>
