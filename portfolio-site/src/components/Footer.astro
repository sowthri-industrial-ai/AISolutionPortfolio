---
// Site footer. Three contact links (Email, LinkedIn, GitHub) on the
// left, build attribution on the right.
//
// Inline SVG icons (rather than an icon library) — keeps the bundle
// at zero JS, no extra deps, and the icons are visually consistent
// with <GitHubLink> in the cards.
//
// External link discipline:
//   mailto: → no target / rel needed
//   https links → target="_blank" rel="noopener noreferrer"

const year = new Date().getFullYear();

const CONTACT = {
  email: 'sowthri2020@yahoo.com',
  linkedin: 'https://www.linkedin.com/in/sowthri-somasundaram-baa82039/',
  github: 'https://github.com/sowthri-industrial-ai/AISolutionPortfolio',
} as const;
---

<footer class="mt-16 border-t border-slate-200 bg-white">
  <div
    class="container mx-auto flex max-w-4xl flex-col gap-4 px-4 py-6 text-sm text-slate-600 sm:flex-row sm:items-center sm:justify-between"
  >
    {/* Contact links */}
    <ul class="flex flex-wrap items-center gap-x-5 gap-y-2">
      <li>
        <a
          href={`mailto:${CONTACT.email}`}
          class="inline-flex items-center gap-1.5 transition-colors hover:text-slate-900"
        >
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            <path d="m2 7 10 6 10-6"></path>
          </svg>
          <span>Email</span>
        </a>
      </li>
      <li>
        <a
          href={CONTACT.linkedin}
          class="inline-flex items-center gap-1.5 transition-colors hover:text-slate-900"
          rel="noopener noreferrer"
          target="_blank"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.95v5.66H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"
            ></path>
          </svg>
          <span>LinkedIn</span>
        </a>
      </li>
      <li>
        <a
          href={CONTACT.github}
          class="inline-flex items-center gap-1.5 transition-colors hover:text-slate-900"
          rel="noopener noreferrer"
          target="_blank"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2c-3.2.7-3.87-1.36-3.87-1.36-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.69.08-.69 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.69 1.24 3.34.95.1-.74.4-1.24.73-1.53-2.55-.29-5.24-1.27-5.24-5.66 0-1.25.45-2.27 1.18-3.07-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.16 1.17.92-.26 1.91-.39 2.89-.4.98.01 1.97.14 2.89.4 2.2-1.48 3.16-1.17 3.16-1.17.62 1.58.23 2.75.11 3.04.74.8 1.18 1.82 1.18 3.07 0 4.4-2.69 5.37-5.25 5.66.41.36.78 1.07.78 2.16v3.2c0 .31.21.68.8.56C20.71 21.39 24 17.08 24 12 24 5.65 18.85.5 12 .5z"
            ></path>
          </svg>
          <span>GitHub</span>
        </a>
      </li>
    </ul>

    {/* Build attribution */}
    <span class="text-xs text-slate-500">
      &copy; {year} Sowthri Somasundaram · Built with
      <a
        href="https://astro.build"
        class="underline transition-colors hover:text-slate-900"
        rel="noopener noreferrer"
        target="_blank">Astro</a
      >
    </span>
  </div>
</footer>
