---
// BaseLayout — site-wide HTML envelope. Wraps every page in
// <Header>/<Footer> with the Tailwind-styled body. Keep this minimal;
// per-page concerns (hero, content) live in the calling page.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  /** Browser tab title; used as `<title>`. */
  title: string;
  /** Optional meta description for OG / SEO. */
  description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body class="flex min-h-screen flex-col bg-slate-50 text-slate-900 antialiased">
    <Header />
    <main class="container mx-auto max-w-4xl flex-1 px-4 py-10">
      <slot />
    </main>
    <Footer />
  </body>
</html>
