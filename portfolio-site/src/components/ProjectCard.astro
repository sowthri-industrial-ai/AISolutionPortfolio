---
// Home-grid card for one project. Visual treatment is **identical
// across all statuses** (Live / In Development / Planned) per the
// kickoff requirement — the only conditional visual is the
// <DemoStatusIndicator> pill colour and the demo CTA being absent
// when no demoUrl is set.
//
// Card click-through: the title link uses the "stretched link"
// pattern — its ::after pseudo-element covers the entire card via
// `before:absolute before:inset-0`, making any click on the card
// body navigate to /projects/<slug>. The footer's external links
// (GitHub, demo) sit on a higher z-index so they remain separately
// clickable as click-stoppers.
//
// `relative` on the <article> bounds the stretched-link overlay.
// `relative z-10` on the footer keeps GitHub + demo links above it.

import type { CollectionEntry } from 'astro:content';
import DemoStatusIndicator from './DemoStatusIndicator.astro';
import TechStackTable from './TechStackTable.astro';
import GitHubLink from './GitHubLink.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { title, status, tagline, summary, techStack, githubPath, demoUrl } = project.data;
const profileUrl = `/projects/${project.id}`;
---

<article
  class="relative flex flex-col gap-3 rounded-lg border border-slate-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-md"
>
  <header class="flex items-start justify-between gap-3">
    <h3 class="text-xl font-semibold tracking-tight text-slate-900">
      <a
        href={profileUrl}
        class="transition-colors before:absolute before:inset-0 before:content-[''] hover:text-slate-700"
      >
        {title}
      </a>
    </h3>
    <DemoStatusIndicator status={status} />
  </header>
  <p class="text-sm font-medium leading-relaxed text-slate-700">{tagline}</p>
  <p class="text-sm leading-relaxed text-slate-600">{summary}</p>
  <TechStackTable items={techStack} limit={4} />
  <footer class="relative z-10 mt-auto flex flex-wrap items-center gap-x-5 gap-y-2 pt-3">
    <GitHubLink path={githubPath} />
    {
      demoUrl && (
        <a
          href={demoUrl}
          class="inline-flex items-center gap-1 text-sm font-medium text-emerald-700 transition-colors hover:text-emerald-900"
          rel="noopener noreferrer"
          target="_blank"
        >
          Open live demo →
        </a>
      )
    }
  </footer>
</article>
