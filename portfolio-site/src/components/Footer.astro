---
// Site footer. Copyright + build attribution + source link.
const year = new Date().getFullYear();
---

<footer class="mt-12 border-t border-slate-200 bg-white">
  <div
    class="container mx-auto flex max-w-4xl flex-col gap-2 px-4 py-6 text-sm text-slate-600 sm:flex-row sm:items-center sm:justify-between"
  >
    <span>&copy; {year} Sowthri Somasundaram</span>
    <span>
      Built with
      <a
        href="https://astro.build"
        class="underline transition-colors hover:text-slate-900"
        rel="noopener noreferrer"
        target="_blank">Astro</a
      >
      ·
      <a
        href="https://github.com/sowthri-industrial-ai/AISolutionPortfolio"
        class="underline transition-colors hover:text-slate-900"
        rel="noopener noreferrer"
        target="_blank">Source on GitHub</a
      >
    </span>
  </div>
</footer>
