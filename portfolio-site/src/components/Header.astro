---
// Site header. Owner branding on the left, single nav link on the
// right (just Home in v1; about/blog/etc. deferred). Same chrome
// every page sees via BaseLayout.
---

<header class="border-b border-slate-200 bg-white">
  <div class="container mx-auto flex max-w-4xl items-center justify-between px-4 py-4">
    <a href="/" class="text-lg font-semibold text-slate-900 transition-colors hover:text-slate-600">
      Sowthri Somasundaram
      <span class="hidden font-normal text-slate-500 sm:inline">· AI Solution Portfolio</span>
    </a>
    <nav class="text-sm">
      <a href="/" class="text-slate-600 transition-colors hover:text-slate-900"> Home </a>
    </nav>
  </div>
</header>
